# Supabase project settings (never put real credentials in this file)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Service role is server-only; never prefix it with NEXT_PUBLIC_.

# Production: https://paz.darb.co.il and https://admin.paz.darb.co.il (set in Vercel).
# For local .env.local: http://localhost:3000 and http://localhost:3001.
NEXT_PUBLIC_APP_URL=https://paz.darb.co.il
NEXT_PUBLIC_ADMIN_URL=https://admin.paz.darb.co.il

# Optional origin for the NFC tag URL shown/copied in admin; defaults to NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_NFC_APP_URL=

# Push notification dispatcher (server-only). Called by the Supabase scheduler;
# see scripts/sql/NOTIFICATION-SCHEDULER.md. Leave disabled unless configured.
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_CRON_SECRET=
EXPO_ACCESS_TOKEN=

# Station interest form (server-only). The rate secret must be at least 32 characters.
# Email delivery is optional and needs all three of the Resend values below.
STATION_LEADS_RATE_SECRET=
RESEND_API_KEY=
STATION_LEADS_EMAIL=
STATION_LEADS_FROM=
