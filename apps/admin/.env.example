# Supabase project settings (never put real credentials in this file)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Service role is server-only; never prefix it with NEXT_PUBLIC_.

# Set both to actual deployment origins, then redeploy both apps.
# Temporary Vercel domains now; authorized custom domains can replace them later.
# For local .env.local ONLY: http://localhost:3000 and http://localhost:3001.
# These placeholders are examples, not working deployment URLs.
NEXT_PUBLIC_APP_URL=https://your-worker-app.vercel.app
NEXT_PUBLIC_ADMIN_URL=https://your-admin-app.vercel.app
