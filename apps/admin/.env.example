# Supabase project settings (never put real credentials in this file)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Service role is server-only; never prefix it with NEXT_PUBLIC_.

# Set both to actual deployment origins, then redeploy both apps.
# Current Darb deployment domains; keep the legacy worker host serving existing NFC tags.
# For local .env.local ONLY: http://localhost:3000 and http://localhost:3001.
# Set these in Vercel Production; .env.example is documentation, not runtime configuration.
NEXT_PUBLIC_APP_URL=https://paz.darb.co.il
NEXT_PUBLIC_ADMIN_URL=https://admin.paz.darb.co.il

# NFC link shown/copied in admin: retain the existing physical tag origin.
# After rewriting tags, change this to https://paz.darb.co.il and redeploy admin.
# For local development omit it (falls back to NEXT_PUBLIC_APP_URL).
NEXT_PUBLIC_NFC_APP_URL=https://paz-shifts.vercel.app
