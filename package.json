{
  "name": "yellowshifts-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "create-admin": "node --env-file=apps/admin/.env.local scripts/create-platform-admin.mjs",
    "create-user": "node --env-file=apps/admin/.env.local scripts/create-station-user.mjs",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "prettier": "^3.5.2",
    "turbo": "^2.10.12",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
